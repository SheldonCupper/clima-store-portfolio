# Copie as variáveis para o .env da raiz. Nunca use prefixo VITE_ para segredos.
# Mantenha false até ter SMTP configurado e testar a entrega real.
EMAIL_VERIFICATION_REQUIRED=false
APP_PUBLIC_URL=http://localhost:5173
# Em produção: URL pública HTTPS da loja, sem caminho ou parâmetros.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM=
# Porta 587: STARTTLS obrigatório. Porta 465: TLS desde a conexão.
# Gmail: SMTP_HOST=smtp.gmail.com, SMTP_USER=seu Gmail,
# SMTP_PASS=senha de app (não a senha comum) e MAIL_FROM=mesmo remetente autorizado.

# Login Google (opcional): cliente OAuth do tipo Aplicativo da Web.
# Configure apenas no .env do backend; não use VITE_ e não envie ao GitHub.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# O retorno é derivado de APP_PUBLIC_URL:
# https://loja.example.com/api/customer/google/callback
# Local: http://localhost:5173/api/customer/google/callback
