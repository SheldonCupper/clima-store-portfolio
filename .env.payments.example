# Copie somente para o .env do backend. Nunca use prefixo VITE_.
PAYMENTS_ENABLED=false
MERCADO_PAGO_ENV=sandbox
# Checkout Pro via Orders: token APP_USR da conta VENDEDORA DE TESTE, não da conta real.
MERCADO_PAGO_ACCESS_TOKEN=
MERCADO_PAGO_WEBHOOK_SECRET=
API_PUBLIC_URL=https://api.example.com
